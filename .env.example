# ---------------------------------------------------------------------------
# CASFETA Zanzibar Digital Management & Ministry Platform (CZDMP)
# Copy this file to ".env" and adjust the values for your environment.
# The file is loaded automatically by casfeta_project/settings.py.
# ---------------------------------------------------------------------------

# Core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database ------------------------------------------------------------------
# sqlite (default, zero configuration) | mysql (recommended production) | postgres
DB_ENGINE=sqlite

# MySQL / PostgreSQL settings (used when DB_ENGINE is mysql or postgres)
DB_NAME=casfeta_czdmp
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Authentication ------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_SIGNING_KEY=
MIN_PASSWORD_LENGTH=8
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# CZDMP financial policy ----------------------------------------------------
# Fallback only - the effective percentage lives in the FinancialPolicy table.
JIMBO_CONTRIBUTION_PERCENTAGE=10.00
DEFAULT_CURRENCY=TZS
CONTRIBUTION_DUE_DAYS=7
REPORT_DEADLINE_DAY=5

# Localisation --------------------------------------------------------------
DJANGO_LANGUAGE_CODE=sw
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

# Uploads -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20

# Notifications (SRS 44 - email/SMS/WhatsApp are optional integration channels)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@casfeta-zanzibar.or.tz
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_URL=

# Backups (SRS 47)
BACKUP_DIR=
